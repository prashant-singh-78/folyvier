# Server & Frontend URLs
APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000

# MongoDB Atlas (leave empty in local dev to use persistent local JSON store fallback)
MONGODB_URI=
MONGODB_DB_NAME=folibeir

# JWT & HTTP-Only Cookie Security
JWT_SECRET=change-this-to-a-strong-64-char-random-secret-in-production
JWT_EXPIRE_HOURS=12
JWT_REMEMBER_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Default Super Admin (seeded on first boot)
DEFAULT_ADMIN_NAME=FOLIBEIR Super Admin
DEFAULT_ADMIN_EMAIL=admin@folibeir.com
DEFAULT_ADMIN_PASSWORD=FolibeirAdmin@2026

# Official Meta WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=folibeir_webhook_verify_token
WHATSAPP_APP_SECRET=
# Configurable Business Owner WhatsApp Number (digits with country code, e.g. 919876543210)
BUSINESS_OWNER_WHATSAPP_NUMBER=
# Optional approved template names for outside 24h window
WHATSAPP_OWNER_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Google OAuth Client ID (for Google Sign-In token verification)
GOOGLE_CLIENT_ID=

# Optional SMTP for Email OTP & Password Reset (when unset, dev OTP is returned/logged securely)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@folibeir.com

# Optional Redis/Celery Broker for distributed background jobs
REDIS_URL=redis://localhost:6379/0
